---
import Base from "@/layouts/Base.astro";
import EntryCard from "@/components/EntryCard.astro";
import HeroGlassDemo from "@/components/HeroGlassDemo";
import { getEntry } from "astro:content";
import { CATEGORIES } from "@/lib/types";
import type { CategoryId, EntryMeta, EntrySchema, Locale } from "@/lib/types";
import { t } from "@/i18n/ui";
import { categoryUrl, entryUrl, homeUrl, resourcesUrl, trendsUrl } from "@/lib/urls";

interface Props {
  locale: Locale;
  metas: EntryMeta[];
}

const { locale, metas } = Astro.props;
const dict = t(locale);
const home = dict.home;
const featured = metas.filter((m) => m.star === 3).slice(0, 6);
const tunable = metas.filter((m) => m.star === 3).length;
const countOf = (id: CategoryId) => metas.filter((m) => m.slug.startsWith(`${id}/`)).length;

// hero live 迷你演示的条目 schema(spec §6-3 dogfood styles/glassmorphism)
const glassEntry = await getEntry("entries", "styles/glassmorphism");
const glassSchema = glassEntry?.data as unknown as EntrySchema | undefined;
const glassEntryUrl = entryUrl(locale, "styles/glassmorphism");
---

<Base locale={locale} title={home.heroTitle} description={home.heroSub} altUrl={homeUrl(locale === "en" ? "zh" : "en")}>
  {/* ── Hero(spec §4.1-1:--step-5 标题 + 副标 + 统计行 + live 迷你演示,≤55vh) ── */}
  <section class="hero">
    <div class="hero-copy">
      <h1>{home.heroTitle}</h1>
      <p class="hero-sub">{home.heroSub}</p>
      <div class="hero-stats">
        <div class="hero-stat">
          <span class="hero-stat-num">{metas.length}</span>
          <span class="hero-stat-label">{home.stats.entries}</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-num">{CATEGORIES.length}</span>
          <span class="hero-stat-label">{home.stats.categories}</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-num">{tunable}</span>
          <span class="hero-stat-label">{home.stats.tunable}</span>
        </div>
      </div>
    </div>

    {
      glassSchema && (
        <div class="hero-live">
          <div class="hero-stage-box">
            <span class="hero-stage-tag">{dict.entry.demo}</span>
            <HeroGlassDemo
              client:visible
              entryId="styles/glassmorphism"
              schema={glassSchema}
              openHref={glassEntryUrl}
              openLabel={home.openEntry}
            />
          </div>
        </div>
      )
    }

    {/* 移动端(<640)降级:静态微缩预览一帧 + 链接进条目(spec §4.1 移动-1) */}
    <div class="hero-static">
      <div class="hero-static-preview" aria-hidden="true" />
      <a class="hero-open" href={glassEntryUrl}>{home.openEntry}</a>
    </div>
  </section>

  <h2 class="section-title">{home.browse}</h2>
  {/* ── 九分类 bento(spec §4.1-2:4 列显式 areas,styles 2×2 hero 格,
       materials/motion/components 1×2 tall,color/type/layout/icons/dataviz 1×1;不用 dense,
       DOM 顺序 = 阅读顺序 = 焦点顺序) ── */}
  <div class="bento">
    {
      CATEGORIES.map((c, i) => {
        const n = countOf(c.id);
        return (
          <a
            class={`bento-cell reveal area-${c.id}`}
            href={categoryUrl(locale, c.id)}
            style={`--cat: var(--cat-${c.id}); --i: ${i};`}
          >
            <span class="bento-name">{locale === "en" ? c.en : c.zh}</span>
            <span class="bento-count">
              <span class="sr-only">{`${n} ${home.entriesCount}`}</span>
              <span class="bento-count-num" aria-hidden="true" data-count={n}>
                {n}
              </span>
              <span>{home.entriesCount}</span>
            </span>
            <span class="bento-preview" aria-hidden="true">
              {c.id === "motion" ? (
                <span class="bp bp-motion">
                  <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                    <path
                      d="M2,98 C28,98 48,10 98,4"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="5"
                      stroke-linecap="round"
                    />
                  </svg>
                </span>
              ) : c.id === "type" ? (
                <span class="bp bp-type">Aa 文</span>
              ) : (
                <span class={`bp bp-${c.id}`} />
              )}
            </span>
          </a>
        );
      })
    }
    <div class="bento-cell is-info reveal area-info" style={`--i: ${CATEGORIES.length};`}>
      <span class="bento-note">{dict.siteTagline}</span>
    </div>
  </div>

  <h2 class="section-title">{home.featured}</h2>
  {/* ── 精选 ★3 条目行(spec §4.1-3:3 列 + StaggeredFadeIn;
       渐变预算只给这几张卡:hover 启动 border-beam 流光,spec §6-10) ── */}
  <div class="entry-grid">
    {
      featured.map((m, i) => (
        <EntryCard
          entry={m}
          locale={locale}
          href={entryUrl(locale, m.slug)}
          featured
          style={`--i: ${i};`}
        />
      ))
    }
  </div>

  {/* ── 授人以渔入口:一行导流到资源页(规范/组件库/工具/画廊);
       旁列「趋势追踪」入口(不入导航,spec 克制:两个静态入口行) ── */}
  <p class="home-res-link">
    <a href={resourcesUrl(locale)}>{dict.resources.homeEntry}</a>
    <a href={trendsUrl(locale)}>{dict.trends.homeEntry}</a>
  </p>
</Base>
