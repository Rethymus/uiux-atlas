---
import type { EntryMeta, Locale } from "@/lib/types";
import { SYSTEMS } from "@/lib/types";
import { displayName } from "@/lib/displayName";

interface Props {
  entry: EntryMeta;
  locale: Locale;
  href: string;
  /** 精选卡(首页 ★3 行):hover 启动 border-beam 流光(spec §6-10) */
  featured?: boolean;
  /** 过滤用 data 属性(FilterBar 客户端显隐卡片) */
  "data-slug"?: string;
  "data-system"?: string;
  "data-star"?: number | string;
  /** 透传到卡片根元素的内联样式(如 reveal 错峰索引 --i) */
  style?: string;
}

const { entry, locale, href, featured = false, ...attrs } = Astro.props;
const { style: extraStyle = "", ...rest } = attrs;
const system = SYSTEMS.find((s) => s.id === entry.system);
const systemLabel = system ? (locale === "en" ? system.en : system.zh) : entry.system;
// 星级 Chip:形状 + aria 文字双编码,颜色/形状不唯一承载(spec §3 Chip / §3 Badge)
const starLabel =
  locale === "en" ? `Parameterization ${entry.star}/3` : `参数化 ${entry.star}/3`;
// §6-9 共享元素过渡:动态赋名 card-<slug> 防重名;「/」不是合法 custom-ident 字符,替换为 -
const viewTransitionName = `card-${entry.slug.replaceAll("/", "-")}`;
---

{/* Card(spec §3):标题 --step-1/600 → tagline 两行截断 → meta Chip×2;reveal 为 §6-4 入场钩子 */}
<a
  class:list={["entry-card", "reveal", { "is-featured": featured }]}
  href={href}
  style={`view-transition-name: ${viewTransitionName};${extraStyle ? ` ${extraStyle}` : ""}`}
  {...rest}
>
  <span class="entry-name">{displayName(entry, locale)}</span>
  <span class="entry-tagline">{entry.tagline[locale]}</span>
  <span class="entry-meta">
    <span class="chip">{systemLabel}</span>
    <span class="chip chip-star" aria-label={starLabel}>
      <span class="stars" aria-hidden="true">{"★".repeat(entry.star)}</span>
    </span>
  </span>
  {
    featured && (
      <span class="beam" aria-hidden="true">
        <span class="beam-light" />
      </span>
    )
  }
</a>
