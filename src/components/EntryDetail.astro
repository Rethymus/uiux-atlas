---
import Base from "@/layouts/Base.astro";
import WorkbenchPanel from "@/components/WorkbenchPanel";
import DemoHost from "@/components/DemoHost";
import BreakdownTabs from "@/components/BreakdownTabs";
import MetaAccordion from "@/components/MetaAccordion.astro";
import { getCollection, render } from "astro:content";
import { CATEGORIES, SYSTEMS } from "@/lib/types";
import type { CategoryId, EntrySchema, Locale } from "@/lib/types";
import { t } from "@/i18n/ui";
import { categoryUrl, entryUrl, homeUrl, resourcesUrl } from "@/lib/urls";
import { goDeeperLinks } from "@/data/resources";
import { displayName, secondaryName } from "@/lib/displayName";
import type { EntryMeta } from "@/lib/types";

interface Props {
  entryId: string;
  schema: EntrySchema;
  locale: Locale;
  /** 同分类上一条/下一条(getStaticPaths 按分类列表同序计算;清单 entry-prev-next-pager) */
  prevMeta?: EntryMeta;
  nextMeta?: EntryMeta;
}

const { entryId, schema, locale, prevMeta, nextMeta } = Astro.props;
const dict = t(locale);
// entryId 首段必为九分类 id(getStaticPaths 只从 CATEGORIES 生成),这里收窄给 goDeeperLinks
const [category] = entryId.split("/") as CategoryId[];
const cat = CATEGORIES.find((c) => c.id === category)!;
const sys = SYSTEMS.find((s) => s.id === schema.system);
const catName = locale === "en" ? cat.en : cat.zh;
const systemLabel = sys ? (locale === "en" ? sys.en : sys.zh) : schema.system;
// 星级 Chip:形状 + aria 文字双编码,颜色/形状不唯一承载(spec §3 Chip;与 EntryCard 同文案)
const starLabel = locale === "en" ? `Parameterization ${schema.star}/3` : `参数化 ${schema.star}/3`;
// 展示名:zh 优先 nameZh(无译名回退 name),en 恒 name;zh 且中英不同名时小字并列英文(可检索性)
const entryName = displayName(schema, locale);
const entryNameEn = secondaryName(schema, locale);

// 对应语言的 MDX 正文(entryBody id 形如 "styles/glassmorphism/zh")
const bodies = await getCollection("entryBody", (b) => b.id === `${entryId}/${locale}`);
const body = bodies[0];
const { Content } = body ? await render(body) : { Content: null };

// Demo 组件:DemoHost 岛屿(client:load)按 entryId 动态解析
// src/content/entries/{category}/{slug}/demo/Demo.tsx 并传入 entryId / schema
const altUrl = entryUrl(locale === "en" ? "zh" : "en", entryId);
---

<Base
  locale={locale}
  title={entryName}
  description={schema.tagline[locale]}
  altUrl={altUrl}
  activeCategory={category}
  ogType="article"
>
  {/* 页面根挂 --cat:渐变带 / 返回链接 / 面包屑当前分类 / Tabs 指示条 / 铭牌点统一消费 */}
  <div class="entry-page" style={`--cat: var(--cat-${category});`}>
    {/* ── 1. 紧凑头(spec §4.3-1:返回链接 + 面包屑 → h1 → aliases 一行 → tagline 一行截断 →
         chips 行;origin 行移出头部,并入 MetaAccordion 的「来源」item) ── */}
    <header class="entry-head">
      <div class="entry-band" aria-hidden="true"></div>
      {/* 返回可供性(清单 entry-back-affordance + breadcrumb-prominence 合并实现):
          「← {分类名}」显式返回链接,分类语义色(--cat 用法纪律③:分类语义处),
          命中区 ≥44px(spec §7,::after 扩边处方);Base.astro 全站脚本对 [data-back]
          接管点击——上一条历史为同源页面时 history.back()(保留列表页滚动位置),
          直链/外站进入时原生 <a href> 兜底回分类列表页 */}
      <div class="entry-navrow">
        <a class="back-link" href={categoryUrl(locale, category)} data-back>
          <span class="back-arrow" aria-hidden="true">←</span>
          {catName}
        </a>
        <nav class="crumbs" aria-label="breadcrumb">
          <a href={homeUrl(locale)}>{dict.nav.home}</a>
          <span aria-hidden="true"> / </span>
          <a class="crumbs-cat" href={categoryUrl(locale, category)}>{catName}</a>
          <span aria-hidden="true"> / </span>
          <span>{entryName}</span>
        </nav>
      </div>
      {/* §6-9 共享元素过渡(条目侧):与来源列表卡同名 —— EntryCard 动态赋名
          card-<slug>(「/」不是合法 custom-ident,替换为 -,防重名),
          跨文档 morph 由 global.css 的 @view-transition 承接(--dur-4 档)。
          Firefox 等不支持 MPA 视图过渡的浏览器:该属性与 @view-transition
          规则均为惰性,退回普通跳转(结构性优雅降级,无 JS 探测)。 */}
      <h1
        class="entry-title"
        style={`view-transition-name: card-${entryId.replaceAll("/", "-")};`}
      >
        {entryName}
        {
          entryNameEn && (
            <span class="entry-title-en" lang="en">
              {entryNameEn}
            </span>
          )
        }
      </h1>
      {
        schema.aliases.length > 0 && (
          <p class="entry-aliases">{schema.aliases.join(" · ")}</p>
        )
      }
      <p class="entry-tagline">{schema.tagline[locale]}</p>
      <div class="entry-meta-row">
        <span class="chip">{systemLabel}</span>
        <span class="chip chip-star" aria-label={starLabel}>
          <span class="stars" aria-hidden="true">{"★".repeat(schema.star)}</span>
        </span>
      </div>
    </header>

    {/* ── 3. Workbench(首屏主角,spec §4.3-3 / §5-1 首屏双要素:
         左 demo-panel(头部行 + 演示台)+ 右仪表台化面板(sticky,面板底部接 Prompt 导出) ── */}
    <div class="workbench">
      <div class="demo-panel">
        <div class="demo-panel-head">
          <span>{dict.entry.demo}</span>
          <span>{dict.entry.officialDefault}</span>
        </div>
        <div class="demo-stage-wrap">
          <DemoHost client:load entryId={entryId} schema={schema} />
        </div>
      </div>
      <WorkbenchPanel client:visible entryId={entryId} schema={schema} locale={locale} />
    </div>

    {/* ── 6. 阅读进度发丝线(spec §6-19):sticky 挂点在 Tabs 区块前,
         只在 Tabs 以下区域出现;RM 隐藏 ── */}
    <div class="read-progress" aria-hidden="true"></div>

    {/* ── 4. MDX 四节 → Tabs(spec §4.3-4 / §3 Tabs):BreakdownTabs 渐进增强,
         客户端把 .prose 按 h2 分组为 tablist + tabpanel;无 JS 时 prose 原样纵排。
         用 client:load 而非 client:visible:SSR 占位是零高度空 div,
         visible 的 IntersectionObserver 在跳滚/锚点场景会错过交叉窗口,永远不水合 ── */}
    <h2 class="section-title">{dict.entry.breakdown}</h2>
    <BreakdownTabs client:load sourceId="entry-prose" label={dict.entry.breakdown} />
    {
      Content && (
        <div class="prose" id="entry-prose">
          <Content />
        </div>
      )
    }

    {/* ── 5. 信息 Accordion(spec §4.3-5 / §3 Accordion):
         场景/避免/a11y/支持/回退/来源 六项收纳,默认全收;来源含 origin ── */}
    <MetaAccordion schema={schema} locale={locale} />

    {/* ── 同分类「上一条 / 下一条」分页器(清单 entry-prev-next-pager):
         顺序 = 分类列表页卡片顺序(getStaticPaths 同源计算);
         单条分类或边界处缺一侧则不渲染该侧,两侧皆缺则整个分页器不渲染 ── */}
    {
      (prevMeta || nextMeta) && (
        <nav class="entry-pager" aria-label={dict.entry.pagerNav}>
          {prevMeta ? (
            <a
              class="pager-cell is-prev"
              href={entryUrl(locale, prevMeta.slug)}
              aria-label={`${dict.entry.pagerPrev}:${displayName(prevMeta, locale)}`}
            >
              <span class="pager-dir">
                <span class="pager-arrow" aria-hidden="true">
                  ←
                </span>
                {dict.entry.pagerPrev}
              </span>
              <span class="pager-name">{displayName(prevMeta, locale)}</span>
            </a>
          ) : (
            <span class="pager-cell is-empty" aria-hidden="true" />
          )}
          {nextMeta ? (
            <a
              class="pager-cell is-next"
              href={entryUrl(locale, nextMeta.slug)}
              aria-label={`${dict.entry.pagerNext}:${displayName(nextMeta, locale)}`}
            >
              <span class="pager-dir">
                {dict.entry.pagerNext}
                <span class="pager-arrow" aria-hidden="true">
                  →
                </span>
              </span>
              <span class="pager-name">{displayName(nextMeta, locale)}</span>
            </a>
          ) : (
            <span class="pager-cell is-empty" aria-hidden="true" />
          )}
        </nav>
      )
    }

    {/* ── 「继续深入」卡(授人以渔):按体系 + 分类的静态映射(src/data/resources.ts,
         无新 collection),2–3 条最相关资源;web-std 额外呈现 schema.sources 官方 URL。
         卡本身不可点击 → 无 hover 态(spec §3「不可点击卡无 hover 态」),内部链接才可交互 ── */}
    <aside class="go-deeper">
      <h2 class="go-deeper-title">{dict.resources.goDeeper}</h2>
      <p class="go-deeper-hint">{dict.resources.goDeeperHint}</p>
      <ul class="go-deeper-links">
        {
          goDeeperLinks(schema.system, category, schema.sources).map((l) => (
            <li>
              <a href={l.url} target="_blank" rel="noopener noreferrer">
                <span class="go-deeper-text">{l.label[locale]}</span>
                <span class="acc-src-ico" aria-hidden="true">
                  ↗
                </span>
                {/* 新窗口提示(a11y-blank-hint-002):sr-only 文本并入链接名,
                    WCAG 2.4.4 + G201;视觉侧 ↗ 图标不承载唯一语义 */}
                <span class="sr-only">
                  {locale === "zh" ? "(在新窗口打开)" : "(opens in new tab)"}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="go-deeper-more" href={resourcesUrl(locale)}>
        {dict.resources.more}
      </a>
    </aside>
  </div>
</Base>
