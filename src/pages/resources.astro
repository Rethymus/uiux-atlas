---
import Base from "@/layouts/Base.astro";
import { RESOURCES, RESOURCE_GROUPS } from "@/data/resources";
import { t } from "@/i18n/ui";
import { homeUrl, resourcesUrl, trendsUrl } from "@/lib/urls";

// 「授人以渔」资源页(zh):五组 × 资源卡;数据全部来自已有调研(src/data/resources.ts)
const dict = t("zh");
const res = dict.resources;
---

<Base
  locale="zh"
  title={res.title}
  description={res.intro}
  altUrl={resourcesUrl("en")}
  activeNav="resources"
>
  <div class="resources-page">
    {/* 返回可供性(清单:非层级页同样接入返回钮):「← 首页」;
        Base.astro 全站脚本对 [data-back] 接管——有同源站内历史时 history.back(),
        直链/外站进入时原生 <a href> 兜底回首页 */}
    <p class="page-back">
      <a class="back-link" href={homeUrl("zh")} data-back>
        <span class="back-arrow" aria-hidden="true">←</span>
        {dict.list.backHome}
      </a>
    </p>
    {/* 页头:与列表页同一骨架(.list-head,--step-4 标题 + mono 计数) */}
    <header class="list-head">
      <h1 class="list-title">{res.title}</h1>
      <p class="list-count">
        <span class="list-count-num">{RESOURCES.length}</span> {res.countLabel}
      </p>
    </header>
    <p class="res-intro">{res.intro}</p>

    {
      RESOURCE_GROUPS.map((gid) => {
        const items = RESOURCES.filter((r) => r.group === gid);
        if (items.length === 0) return null;
        return (
          <section class="res-group">
            <h2 class="section-title">{res.groups[gid].name}</h2>
            {/* 卡片网格沿用规范 .entry-grid;卡基类 .entry-card(hover 微交互 = §3 Card token) */}
            <div class="entry-grid">
              {items.map((r, i) => (
                <a
                  class="entry-card res-card reveal"
                  style={`--i: ${i};`}
                  href={r.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="res-name">
                    {r.name}
                    <span class="res-ext" aria-hidden="true">
                      ↗
                    </span>
                  </span>
                  <span class="res-url">{r.url}</span>
                  <span class="res-desc">{r.desc.zh}</span>
                  {r.tags && r.tags.length > 0 && (
                    <span class="entry-meta">
                      {r.tags.map((tag) => (
                        <span class="chip">{tag}</span>
                      ))}
                    </span>
                  )}
                </a>
              ))}
            </div>
          </section>
        );
      })
    }

    {/* 页尾互链:趋势追踪页(时点快照,与本页「下一站」定位互补) */}
    <p class="home-res-link">
      <a href={trendsUrl("zh")}>{dict.trends.resourcesEntry}</a>
    </p>
  </div>
</Base>
