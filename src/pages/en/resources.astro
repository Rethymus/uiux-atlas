---
import Base from "@/layouts/Base.astro";
import { RESOURCES, RESOURCE_GROUPS } from "@/data/resources";
import { t } from "@/i18n/ui";
import { homeUrl, resourcesUrl, trendsUrl } from "@/lib/urls";

// Resources page (en): five groups × resource cards; data sourced from prior research (src/data/resources.ts)
const dict = t("en");
const res = dict.resources;
---

<Base
  locale="en"
  title={res.title}
  description={res.intro}
  altUrl={resourcesUrl("zh")}
  activeNav="resources"
>
  <div class="resources-page">
    {/* Back affordance (checklist: non-hierarchy pages get a back link too): "← Back home";
        the Base.astro global script intercepts [data-back] — history.back() when the
        previous entry is same-origin, plain <a href> fallback to home otherwise */}
    <p class="page-back">
      <a class="back-link" href={homeUrl("en")} data-back>
        <span class="back-arrow" aria-hidden="true">←</span>
        {dict.list.backHome}
      </a>
    </p>
    {/* Page head: same skeleton as list pages (.list-head, --step-4 title + mono count) */}
    <header class="list-head">
      <h1 class="list-title">{res.title}</h1>
      <p class="list-count">
        <span class="list-count-num">{RESOURCES.length}</span> {res.countLabel}
      </p>
    </header>
    <p class="res-intro">{res.intro}</p>

    {
      RESOURCE_GROUPS.map((gid) => {
        const items = RESOURCES.filter((r) => r.group === gid);
        if (items.length === 0) return null;
        return (
          <section class="res-group">
            <h2 class="section-title">{res.groups[gid].name}</h2>
            {/* Grid reuses the spec .entry-grid; card base class .entry-card (hover micro-interaction = §3 Card tokens) */}
            <div class="entry-grid">
              {items.map((r, i) => (
                <a
                  class="entry-card res-card reveal"
                  style={`--i: ${i};`}
                  href={r.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="res-name">
                    {r.name}
                    <span class="res-ext" aria-hidden="true">
                      ↗
                    </span>
                  </span>
                  {/* New-window hint (a11y-blank-hint-002): sr-only text joins the link name */}
                  <span class="sr-only">(opens in new tab)</span>
                  <span class="res-url">{r.url}</span>
                  <span class="res-desc">{r.desc.en}</span>
                  {r.tags && r.tags.length > 0 && (
                    <span class="entry-meta">
                      {r.tags.map((tag) => (
                        <span class="chip">{tag}</span>
                      ))}
                    </span>
                  )}
                </a>
              ))}
            </div>
          </section>
        );
      })
    }

    {/* Footer cross-link: trend tracker page (point-in-time snapshots, a companion to this page's "next stop" role) */}
    <p class="home-res-link">
      <a href={trendsUrl("en")}>{dict.trends.resourcesEntry}</a>
    </p>
  </div>
</Base>
